<[file][][]

	// Gee Bee R2 Super Sportster            (NOT INCLUDED IN THIS PACKAGE)
	// 1933 version NR2101 number 7

	// INTRODUCTION
	// In 1933 the R2 is re-engined with the R1's previous engine. Rudder extension
	// is added in the same way that for the R1. New wings are thicker and have an
	// increased area. Flaps are added too, lowering the landing speed at 65 mph.

	// CHARACTERISTICS
	// Powerplant : 550  or 800 horsepower Pratt & Whitney Wasp Sr. 1344
	// Tail wheel : fixed
	// Propeller : Smith controllable pitch
	// Nav light : wing tip and tail fin

    <[modelmanager][][]
        <[pointer_list_tmgraphics][DynamicObjects][]

			// Tail wheel : fixed
            <[rigidbody][TailGear][]
                <[float64][Mass][10.9]>
                <[tmvector3d][InertiaLength][ 0.4 0.2 0.2 ]>
                <[tmvector3d][R0][ -2.27 0 -0.165 ]>
                <[tmmatrix3d][B0][ 1 0 0 0 1 0 0 0 1 ]>
            >
            <[multibody_joint][JointFuselageTailGear][]
                <[string8][Body0][Fuselage]>
                <[string8][Body1][TailGear]>
                <[tmvector3d][X0][0.0 0.0 -1.0]>
                <[tmvector3d][R0][ -2.18566 0 0.32795 ]>
                <[string8][InputLock][1.0]>
                <[string8][InputPosition][ServoRudder.Output]>
                <[string8][InputLock][1.0]>
                <[uint32][Type][0]>
            >
            <[wheel][TailWheelHull][]
                <[float64][K][175000]>
                <[float64][D][1500]>
                <[float64][Radius][0.057]>
                <[float64][Width][0.07627]>
                <[float64][RimRadius][0.045]>
                <[float64][Inflation][344738.0]>
                <[string8][Body][TailGear]>
                <[tmvector3d][R0][-2.264 0 -0.3258]>
            >

            <[collisionhull][CollisionFuselage][]
                <[float64][K][2505000]>
                <[float64][D][4175]>
                <[string8][Body][Fuselage]>
                <[string8][Geometry][Fuselage]>
                <[float64][StaticFrictionCoefficient][1.0]>
                <[float64][KineticFrictionCoefficient][0.4]>
                <[bool][InstantCrash][true]>
            >

        >
        <[pointer_list_tmgraphics][GraphicObjects][]

            <[rigidbodygraphics][Fuselage][]
                <[uint32][PositionID][Fuselage.R]>
                <[uint32][OrientationID][Fuselage.Q]>
				<[string8][GeometryList][ Fuselage FuseDecalsGbr2 ]>
            >
            <[hingedbodygraphics][DoorDecal][]
                <[uint32][PositionID][Fuselage.R]>
                <[uint32][OrientationID][Fuselage.Q]>
				<[string8][GeometryList][ DoorDecalGbr2 ]>
                <[uint32][Input][DoorMapping.Output]>
                <[tmvector3d][Axis][0.000000 0.192857 0.981227]>
                <[tmvector3d][Pivot][-0.720988 -0.575004 0.318745]>
            >
            <[hingedbodygraphics][Rudder][]
                <[string8][GeometryList][ Rudder1933 RudderDecalGbr2 ]>
                <[uint32][PositionID][Fuselage.R]>
                <[uint32][OrientationID][Fuselage.Q]>
                <[uint32][InputID][ServoRudder.Output]>
                <[tmvector3d][Axis][0.000000 0.000000 -1.000000]>
                <[tmvector3d][Pivot][-2.215740 0.000000 0.727731]>
            >
			// Tail wheel : fixed
            <[rotatingbodygraphics][TailWheel][]
                <[string8][GeometryList][ TailWheel1933 ]>
                <[uint32][PositionID][TailGear.R]>
                <[uint32][OrientationID][TailGear.Q]>
                <[uint32][AngleID][TailWheelHull.RotationAngle]>
                <[tmvector3d][Axis][0.000000 1.000000 0.000000]>
                <[tmvector3d][Pivot][-2.264349 0.014752 -0.325791]>
            >
        >
    >
>
			// Flaps are added too, lowering the landing speed at 65 mph.
            <[hingedbodygraphics][RightFlap][]
                <[string8][GeometryList][  ]>
                <[uint32][PositionID][RightWing.R]>
                <[uint32][OrientationID][RightWing.Q]>
                <[uint32][InputID][ServoFlaps.Output]>
                <[tmvector3d][Axis][ 0.0 -1.0 0.0 ]>
                <[tmvector3d][Pivot][0.314 -1.332 -0.112]>
            >
            <[hingedbodygraphics][LeftFlap][]
                <[string8][GeometryList][  ]>
                <[uint32][PositionID][LeftWing.R]>
                <[uint32][OrientationID][LeftWing.Q]>
                <[uint32][InputID][ServoFlaps.Output]>
                <[tmvector3d][Axis][ 0.0 -1.0 0.0 ]>
                <[tmvector3d][Pivot][0.314 1.332 -0.112]>
            >
			// pilot for tests
            <[rigidbodygraphics][PilotLow][]
                <[uint32][PositionID][Fuselage.R]>
                <[uint32][OrientationID][Fuselage.Q]>
                <[string8][GeometryList][ PilotUpperLegLeft PilotLowerLegLeft PilotFootLeft PilotUpperLegRight PilotLowerLegRight PilotFootRight PilotArmLeft PilotForearmLeft PilotHandLeft PilotArmRight PilotForearmRight PilotHandRight PilotBodyR PilotShoulder PilotGlasses PilotHeadR PilotHelmetR ]>
                <[uint32][ShowInside][9]>
            >
        >
    >
>