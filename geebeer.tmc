<[file][][]    <[modelinformation][][]        <[int32][Version][220]>        <[list_vector4_float64][ContactSpheres][ (1.253 0.9716 -1.19 0.276) (1.253 -0.9716 -1.19 0.276) (-2.43 0 -0.4008 0.089) ]>
        <[stringt8c][ICAO][]>        <[string8][DisplayName][Gee Bee Model R]>
        <[string8][DisplayNameFull][Gee Bee Model R Super Sportster]>
        <[list_localized_text][Descriptions][]            <[localized_text][element][0]                <[string8][Language][en]>                <[string8][Text][The Gee Bee Model R Super Sportster was a special purpose racing aircraft made by Granville Brothers Aircraft of Springfield, Massachusetts. Gee Bee stands for Granville Brothers. Converted from X-Plane by Krzysztof Kaniewski. Original 3D model made by Active.]>			>            <[localized_text][element][1]                <[string8][Language][de]>                <[string8][Text][Das Gee Bee Model R Super Sportster war ein Rennflugzeug für spezielle Zwecke, hergestellt von der Granville Brothers Aircraft aus Springfield, Massachusetts. Gee Bee steht für Granville Brothers. Konvertiert von X-Plane durch Krzysztof Kaniewski. Ursprüngliches 3D-Modell von Active.]>			>
            <[localized_text][element][2]                <[string8][Language][pl]>                <[string8][Text][Gee Bee Model R Super Sportster był specjalnym samolotem wyścigowym wyprodukowanym przez Granville Brothers Aircraft ze Springfield w stanie Massachusetts. Gee Bee to skrót od Granville Brothers. Przerobiony z X-Plane przez Krzysztofa Kaniewskiego. Oryginalny model 3D wykonany przez Active.]>			>        >        <[float64][MaximumTakeoffMass][1394.8]>        <[float64][WingSpan]          [7.62]>
