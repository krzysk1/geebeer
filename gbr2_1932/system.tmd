<[file][][]

	// Gee Bee R2 Super Sportster
	// 1932 version NR2101 number 7

	// INTRODUCTION
	// The R2 is the sister ship of the R1. Except a few minor differences, they
	// were identical. The R2 was intended to compete the Bendix Trophy, a cross
	// country race from Los Angeles to Cleveland. Lee Gehlbach flew it and made
	// fourth. Gehlbach also entered the Thompson Trophy and took the fifth place.

	// CHARACTERISTICS
	// Empty weight : 1796 lb
	// Gross weight : 3883 lb with full tanks - 2371 lb with 50 gallons of fuel for closed course racing
	// Powerplant : 550 horsepower Pratt & Whitney Wasp Jr. 985
	// Maximum speed : 250 mph
	// Tail wheel : fixed (can be unlatched for easier handling)
	// Propeller : Smith controllable pitch
	// Nav light : wing tip and tail fin

    <[modelmanager][][]
        <[pointer_list_tmgraphics][DynamicObjects][]

            // Tail wheel : fixed (can be unlatched for easier handling)
            <[rigidbody][TailGear][]
                <[float64][Mass][10.9]>
                <[tmvector3d][InertiaLength][ 0.4 0.2 0.2 ]>
                <[tmvector3d][R0][ -2.27 0 -0.165 ]>
                <[tmmatrix3d][B0][ 1 0 0 0 1 0 0 0 1 ]>
            >
            <[multibody_joint][JointFuselageTailGear][]
                <[string8][Body0][Fuselage]>
                <[string8][Body1][TailGear]>
                <[tmvector3d][X0][0.0 0.0 -1.0]>
                <[tmvector3d][R0][ -2.18566 0 0.32795 ]>
                <[string8][InputLock][1.0]>
                <[string8][InputPosition][ServoRudder.Output]>
                <[string8][InputLock][1.0]>
                <[uint32][Type][0]>
            >
            <[wheel][TailWheelHull][]
